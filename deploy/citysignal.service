[Unit]
Description=Citysignal NYC event scanner and web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=citysignal
WorkingDirectory=/opt/citysignal
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=GITHUB_SYNC=1
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
